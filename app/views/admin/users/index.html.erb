<div class="page-container admin-page-container">

  <%# ─── Header ─────────────────────────────────────────────── %>
  <div class="admin-header">
    <div class="header-with-back">
      <%= link_to "←", lobbies_path, class: "btn-back", title: "Zurück" %>
      <h1 class="admin-title">Benutzerverwaltung</h1>
    </div>
  </div>

  <%# ─── Users Table Card ──────────────────────────────────── %>
  <div class="card admin-card mb-4">
    <div class="card-header admin-card-header">
      <div class="admin-section-header">
        <h2 class="admin-section-title">Benutzer</h2>
        <span class="admin-section-badge"><%= @users.count %> Benutzer</span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table admin-users-table">
          <thead>
            <tr>
              <th class="text-center" style="width: 70px;">ID</th>
              <th>Benutzername</th>
              <th class="text-center" style="width: 120px;">Rolle</th>
              <th class="text-center" style="width: 170px;">Erstellt am</th>
              <th class="text-center" style="width: 120px;">Submissions</th>
              <th class="text-center" style="width: 180px;">Rollenverwaltung</th>
              <th class="text-center" style="width: 110px;">Aktionen</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr class="<%= 'current-user-row' if user == current_user %>">
                <td class="td-dim text-center">#<%= user.id %></td>
                <td>
                  <div class="user-cell">
                    <strong><%= user.name %></strong>
                    <% if user == current_user %>
                      <span class="badge badge-info">Du</span>
                    <% end %>
                  </div>
                </td>
                <td class="text-center">
                  <% if user.admin? %>
                    <span class="badge badge-admin">Admin</span>
                  <% else %>
                    <span class="badge badge-user">Benutzer</span>
                  <% end %>
                </td>
                <td class="td-dim text-center"><%= user.created_at.strftime("%d.%m.%Y %H:%M") %></td>
                <td class="td-dim text-center"><%= user.submissions.count %></td>
                <td class="text-center">
                  <% if user == current_user %>
                    <span class="text-muted text-sm">-</span>
                  <% elsif user.admin? %>
                    <%= button_to "Admin entfernen", toggle_admin_admin_user_path(user), method: :patch, class: "btn btn-outline-secondary btn-sm", data: { turbo_confirm: "Admin-Rechte für #{user.name} wirklich entfernen?" } %>
                  <% else %>
                    <%= button_to "Admin hinzufügen", toggle_admin_admin_user_path(user), method: :patch, class: "btn btn-secondary btn-sm" %>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if user == current_user %>
                    <span class="text-muted text-sm">-</span>
                  <% else %>
                    <%= button_to "Löschen", admin_user_path(user), method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Benutzer '#{user.name}' und alle zugehörigen Daten wirklich löschen?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%# ─── Activity Log Card ─────────────────────────────────── %>
  <div class="card admin-card">
    <div class="card-header admin-card-header">
      <div class="admin-section-header">
        <h2 class="admin-section-title">Aktivitätsprotokoll</h2>
        <span class="admin-section-badge">letzte 20</span>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table activity-log-table">
          <thead>
            <tr>
              <th style="width: 200px;">Zeitpunkt</th>
              <th style="width: 200px;">Benutzer</th>
              <th>Aktion</th>
            </tr>
          </thead>
          <tbody>
            <% ActivityLog.recent.limit(20).each do |log| %>
              <tr>
                <td class="td-dim"><%= log.created_at.strftime("%d.%m.%Y %H:%M:%S") %></td>
                <td><strong><%= log.user&.name || "Gelöschter Benutzer" %></strong></td>
                <td><code class="log-action"><%= log.action %></code></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
