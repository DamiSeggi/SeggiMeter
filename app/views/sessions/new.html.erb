<div class="auth-wrapper">
  <div class="card auth-card">
    <div class="auth-header">
      <h1 class="auth-title">SeggiMeter</h1>
      <p class="auth-subtitle">Live Word Cloud &amp; Interactive Polling</p>
    </div>

    <%= form_with url: login_path, method: :post, local: true, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :name, "Username", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Your username", required: true, autofocus: true, autocomplete: "username" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true, autocomplete: "current-password" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Log In", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>

    <div class="auth-footer">
      Don't have an account yet?
      <%= link_to "Register here", signup_path, class: "auth-link" %>
    </div>
  </div>
</div>
