<div class="auth-wrapper">
  <div class="card auth-card">
    <div class="auth-header">
      <h1 class="auth-title">SeggiMeter</h1>
      <p class="auth-subtitle">Create a new account</p>
    </div>

    <%= form_with model: @user, url: signup_path, method: :post, local: true, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :name, "Username", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Choose a username", required: true, autofocus: true, autocomplete: "username" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password (min. 12 characters)", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••••••", required: true, autocomplete: "new-password" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: "••••••••••••", required: true, autocomplete: "new-password" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Register", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>

    <div class="auth-footer">
      Already have an account?
      <%= link_to "Log in here", login_path, class: "auth-link" %>
    </div>
  </div>
</div>
