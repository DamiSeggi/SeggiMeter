<div class="lobby-index-page">
  <header class="top-nav">
    <div class="nav-brand">
      <h2>SeggiMeter</h2>
    </div>

    <div class="nav-user-actions">
      <span class="logged-in-user">
        Logged in as: <strong><%= current_user.name %></strong><%= " (Admin)" if current_user.admin? %>
      </span>
      <% if current_user.admin? %>
        <%= link_to admin_users_path, class: "icon-btn admin-icon-btn", title: "User Management" do %>
          <%= icon(:shield, size: 15) %> Admin
        <% end %>
      <% end %>
      <%= link_to profile_path, class: "icon-btn profile-icon-btn", title: "User Profile" do %>
        <%= icon(:user, size: 15) %> Profile
      <% end %>
      <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline-danger" %>
    </div>
  </header>

  <main class="main-content">
    <div class="content-header">
      <h2 class="section-title">Active Lobbies</h2>
    </div>

    <% if @lobbies.empty? %>
      <div class="empty-state">
        <p>No lobbies available yet.</p>
        <% if current_user.admin? %>
          <p>Click the <strong>+</strong> in the bottom right corner to create a new lobby.</p>
        <% end %>
      </div>
    <% else %>
      <div class="lobbies-grid">
        <% @lobbies.each do |lobby| %>
          <div class="card lobby-card">
            <div class="lobby-card-body">
              <h4 class="lobby-title"><%= lobby.title %></h4>
              <div class="lobby-meta">
                <span class="meta-item"><%= icon(:author, size: 14) %> <%= lobby.user.name %></span>
                <span class="meta-item"><%= icon(:message, size: 14) %> <%= lobby.submissions.count %> <%= lobby.submissions.count == 1 ? "word" : "words" %></span>
              </div>
            </div>
            <div class="lobby-card-footer">
              <%= link_to "Enter →", lobby_path(lobby), class: "btn btn-primary btn-block" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>

  <% if current_user.admin? %>
    <div class="floating-admin-action">
      <%= link_to new_lobby_path, class: "floating-add-btn", title: "Create Lobby" do %>
        <%= icon(:plus, size: 24, stroke_width: 2.5) %>
      <% end %>
    </div>
  <% end %>
</div>
