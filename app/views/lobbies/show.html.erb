<div class="lobby-live-page">
  <header class="live-nav">
    <div class="nav-left">
      <%= link_to "←", lobbies_path, class: "btn-back", title: "Zurück" %>
    </div>
    <div class="nav-right">
      <span class="user-pill"><%= icon(:user, size: 14) %> <%= current_user.name %></span>
    </div>
  </header>

  <main class="live-main-content">
    <div class="live-header-box">
      <%= render "lobbies/title", lobby: @lobby %>
    </div>

    <%= turbo_stream_from "lobby_#{@lobby.id}" %>
    <%= render "lobbies/word_cloud", lobby: @lobby %>
  </main>

  <footer class="live-footer-bar">
    <%= render "lobbies/submission_form", lobby: @lobby %>
  </footer>
</div>
