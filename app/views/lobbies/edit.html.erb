<div class="page-container narrow-container">
  <div class="card">
    <div class="card-header">
      <div class="header-with-back">
        <%= link_to "←", lobby_path(@lobby), class: "btn-back", title: "Zurück" %>
        <h2>Frage bearbeiten</h2>
      </div>
    </div>

    <div class="card-body">
      <%= form_with model: @lobby, local: true do |f| %>
        <% if @lobby.errors.any? %>
          <div class="form-errors">
            <ul>
              <% @lobby.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :title, "Fragen-Titel", class: "form-label" %>
          <%= f.text_field :title, class: "form-control", required: true, autofocus: true %>
        </div>

        <div class="form-actions">
          <%= f.submit "Speichern", class: "btn btn-primary" %>
          <%= link_to "Abbrechen", unlock_lobby_path(@lobby), data: { turbo_method: :post }, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
