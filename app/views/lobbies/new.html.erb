<div class="page-container narrow-container">
  <div class="card">
    <div class="card-header">
      <div class="header-with-back">
        <%= link_to "←", lobbies_path, class: "btn-back", title: "Back" %>
        <h2>Create New Question</h2>
      </div>
    </div>

    <div class="card-body">
      <%= form_with model: @lobby, local: true do |f| %>
        <% if @lobby.errors.any? %>
          <div class="form-errors">
            <ul>
              <% @lobby.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :title, "Question / Topic", class: "form-label" %>
          <%= f.text_field :title, class: "form-control", placeholder: "e.g. What comes to mind when you think of Ruby on Rails?", required: true, autofocus: true %>
        </div>

        <div class="form-actions">
          <%= f.submit "Create Question", class: "btn btn-primary" %>
          <%= link_to "Cancel", lobbies_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
